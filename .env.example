# SLOTH Environment Configuration

# Local Ollama AI Base URL (Default: http://127.0.0.1:11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Default Local Open-Weight Model (e.g. qwen2.5:3b, llama3.2:3b, mistral:latest)
SLOTH_DEFAULT_MODEL=qwen2.5:3b

# Backend Host & Port
SLOTH_HOST=127.0.0.1
SLOTH_PORT=8000

# Concurrency Limit (workers processing files in parallel)
SLOTH_CONCURRENCY_LIMIT=2

# Privacy Mode (ensures 100% local processing)
SLOTH_LOCAL_ONLY_MODE=true
